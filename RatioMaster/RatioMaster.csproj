<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <OutputType>WinExe</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>RatioMaster</AssemblyName>
    <RootNamespace>RatioMaster</RootNamespace>
    <ApplicationIcon>Resources\Main.ico</ApplicationIcon>
    <ApplicationManifest>Properties\app.manifest</ApplicationManifest>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>bin\</OutputPath>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <Deterministic>false</Deterministic>
    <GenerateSupportedRuntime>false</GenerateSupportedRuntime>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
    <DebugType>full</DebugType>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
    <DebugType>none</DebugType>
    <Optimize>true</Optimize>
    <Prefer32Bit>false</Prefer32Bit>
  </PropertyGroup>
  <PropertyGroup>
    <CommonSourcesDir>$(MSBuildThisFileDirectory)..\..\common\</CommonSourcesDir>
    <UseLocalCommon Condition="'$(UseLocalCommon)' == '' And Exists('$(CommonSourcesDir)sergiye.Common')">true</UseLocalCommon>
    <UseLocalCommon Condition="'$(UseLocalCommon)' == ''">false</UseLocalCommon>
  </PropertyGroup>
  <ItemGroup Condition="'$(UseLocalCommon)' == 'true'">
    <EmbeddedResource Include="$(CommonSourcesDir)themes\*.json" Link="themes\%(Filename)%(Extension)" />
    <Compile Include="$(CommonSourcesDir)sergiye.Common.UI\Themes\DarkTheme.cs" Link="Common\Themes\DarkTheme.cs" />
    <Compile Include="$(CommonSourcesDir)sergiye.Common.UI\Themes\LightTheme.cs" Link="Common\Themes\LightTheme.cs" />
    <Compile Include="$(CommonSourcesDir)sergiye.Common.UI\Themes\Theme.cs" Link="Common\Themes\Theme.cs" />
    <Compile Include="$(CommonSourcesDir)sergiye.Common.UI\Themes\CustomTheme.cs" Link="Common\Themes\CustomTheme.cs" />
    <Compile Include="$(CommonSourcesDir)sergiye.Common.UI\Themes\ThemeDraw.cs" Link="Common\Themes\ThemeDraw.cs" />
    <Compile Include="$(CommonSourcesDir)sergiye.Common.UI\Themes\ThemedProfessionalRenderer.cs" Link="Common\Themes\ThemedProfessionalRenderer.cs" />
    <Compile Include="$(CommonSourcesDir)sergiye.Common.UI\Themes\ThemedToolStripRenderer.cs" Link="Common\Themes\ThemedToolStripRenderer.cs" />
    <Compile Include="$(CommonSourcesDir)sergiye.Common.UI\Themes\ThemedTabControl.cs" Link="Common\Themes\ThemedTabControl.cs" />
    <Compile Include="$(CommonSourcesDir)sergiye.Common.UI\Themes\ThemedClosableTabControl.cs" Link="Common\Themes\ThemedClosableTabControl.cs" />
    <Compile Include="$(CommonSourcesDir)sergiye.Common.UI\Themes\ThemedCheckedListBox.cs" Link="Common\Themes\ThemedCheckedListBox.cs" />
    <Compile Include="$(CommonSourcesDir)sergiye.Common.UI\Themes\ThemedControlBorder.cs" Link="Common\Themes\ThemedControlBorder.cs" />
    <Compile Include="$(CommonSourcesDir)sergiye.Common.UI\Themes\ThemedTitleBar.cs" Link="Common\Themes\ThemedTitleBar.cs" />
    <Compile Include="$(CommonSourcesDir)sergiye.Common.UI\Themes\ThemedWindowTitle.cs" Link="Common\Themes\ThemedWindowTitle.cs" />
    <Compile Include="$(CommonSourcesDir)sergiye.Common.UI\Themes\ThemeSupport.cs" Link="Common\Themes\ThemeSupport.cs" />
    <Compile Include="$(CommonSourcesDir)sergiye.Common.UI\ToolStripRadioButtonMenuItem.cs" Link="Common\ToolStripRadioButtonMenuItem.cs" />
    <Compile Include="$(CommonSourcesDir)sergiye.Common.UI\SimplTextBox.cs" Link="Common\SimplTextBox.cs" />
    <Compile Include="$(CommonSourcesDir)sergiye.Common\Extensions\JsonExtensions.cs" Link="Common\JsonExtensions.cs" />
    <Compile Include="$(CommonSourcesDir)sergiye.Common\Tools\OSHelper.cs" Link="Common\OSHelper.cs" />
    <Compile Include="$(CommonSourcesDir)sergiye.Common\Tools\Updater.cs" Link="Common\Updater.cs" />
    <Compile Include="$(CommonSourcesDir)sergiye.Common\Win\WinApiHelper.cs" Link="Common\WinApiHelper.cs" />
  </ItemGroup>
  <ItemGroup Condition="'$(UseLocalCommon)' != 'true'">
    <PackageReference Include="SergiyE.Common" Version="1.*" />
    <PackageReference Include="SergiyE.Common.UI" Version="1.*" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="System.Web.Extensions" />
    <PackageReference Include="Costura.Fody" Version="4.1.0" PrivateAssets="all" />
    <PackageReference Include="Fody" Version="6.9.2" PrivateAssets="all" />
  </ItemGroup>
</Project>
